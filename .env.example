# ═══════════════════════════════════════════════════════
# Monitor Compras Chile — Variables de Entorno
# ═══════════════════════════════════════════════════════
# Copia este archivo como .env y rellena tus valores:
#   cp .env.example .env

# API Mercado Público (solicitar en https://api.mercadopublico.cl)
MERCADO_PUBLICO_TICKET=

# Telegram Bot (crear con @BotFather, obtener chat_id con obtener_chat_id.py)
TELEGRAM_TOKEN=
TELEGRAM_CHAT_ID=

# DeepSeek API (Conan — Cerebro Forense del dashboard)
DEEPSEEK_API_KEY=

# ── Docker (recomendado: VPS / producción) ──
OJO_DATA_DIR=/data
OJO_WEB_PORT=8501
OJO_DOMAIN=monitor.wapnation.cl
DISABLE_STREAMLIT_SCHEDULER=1
# Pipeline: modo agresivo (solo si BACKFILL_ENABLED=0)
DAILY_UPDATE_MAX_OC=5000
CATCHUP_MAX_DAYS=14
# Relleno lento recomendado (evita HTTP 429, arma BD grande)
BACKFILL_ENABLED=1
BACKFILL_OC_BUDGET=500
# Horizontes hacia atrás (180 ≈ 6 meses; subir a 365 para más historia)
BACKFILL_HORIZON_DAYS=180
# Cada cuántas horas corre el scheduler embebido (2 lotes/día)
SCHEDULE_EVERY_HOURS=12
# Re-sincronizar OCs recientes (modo agresivo)
RESYNC_RECENT_DAYS=30
RESYNC_MAX_OCS=200
# SERVEL: recargar cada N días en --full
SERVEL_REFRESH_DAYS=7
# InfoProbidad: sync SPARQL semanal (top proveedores/organismos OC → SQLite)
INFOPROBIDAD_REFRESH_DAYS=7
INFOPROBIDAD_TOP_PROV=40
INFOPROBIDAD_TOP_ORG=12
# Completar RUTs vacíos (detalle OC) + catálogo BuscarProveedor
ENRICH_RUT_MAX_OCS=60
ENRICH_PROVEEDOR_MAX=40
# Detalle/adjudicados de licitaciones por corrida
LIC_DETALLE_MAX=25

# Búsqueda web IA (opcional — más estable que DuckDuckGo scrape)
TAVILY_API_KEY=
BRAVE_SEARCH_API_KEY=
# Desactivar búsqueda web OSINT
# DISABLE_WEB_SEARCH=1

# PostgreSQL opcional (Fase 2 — Railway Postgres)
# DATABASE_URL=postgresql://user:pass@host:5432/ojo_pueblo

# Desactivar auto-update por completo
# DISABLE_AUTO_UPDATE=1
